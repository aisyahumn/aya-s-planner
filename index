<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Aya's Planner 🎀</title>

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;

      display: flex;
      justify-content: center;
      align-items: center;

      overflow: hidden;

      font-family:
        "Trebuchet MS",
        Arial,
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #fff9f5,
          #f9e8e9
        );

      color: #725d60;
    }


    /* Soft decorative circles */

    .blob-one {
      position: absolute;

      width: 240px;
      height: 240px;

      top: -90px;
      left: -80px;

      border-radius: 50%;

      background: #f2d5d8;

      opacity: 0.55;
    }


    .blob-two {
      position: absolute;

      width: 280px;
      height: 280px;

      right: -110px;
      bottom: -120px;

      border-radius: 50%;

      background: #ead9cb;

      opacity: 0.65;
    }


    /* Main card */

    .landing-card {

      width: 90%;
      max-width: 460px;

      position: relative;

      text-align: center;

      padding:
        65px
        30px
        55px;

      background:
        rgba(
          255,
          255,
          255,
          0.82
        );

      border:
        1px solid
        rgba(
          230,
          184,
          190,
          0.45
        );

      border-radius: 35px;

      box-shadow:
        0 18px 50px
        rgba(
          120,
          80,
          85,
          0.12
        );

      backdrop-filter:
        blur(10px);
    }


    .flower {

      font-size: 45px;

      margin-bottom: 20px;

      animation:
        float 3s
        ease-in-out
        infinite;
    }


    h1 {

      font-family:
        Georgia,
        serif;

      font-size: 43px;

      font-weight: normal;

      color: #805d63;

      margin-bottom: 17px;
    }


    .subtitle {

      font-size: 16px;

      line-height: 1.8;

      color: #9a7f82;

      margin-bottom: 37px;
    }


    .enter-button {

      display:
        inline-block;

      padding:
        15px
        31px;

      border-radius:
        50px;

      background:
        #e8bfc6;

      color:
        #ffffff;

      text-decoration:
        none;

      font-size:
        15px;

      font-weight:
        bold;

      letter-spacing:
        0.4px;

      box-shadow:
        0 8px 18px
        rgba(
          190,
          125,
          135,
          0.25
        );

      transition:
        0.25s;
    }


    .enter-button:hover {

      transform:
        translateY(-3px);

      background:
        #ddaeb7;

      box-shadow:
        0 12px 22px
        rgba(
          190,
          125,
          135,
          0.32
        );
    }


    .quote {

      margin-top:
        38px;

      font-size:
        13px;

      color:
        #b39a96;

      letter-spacing:
        0.5px;
    }


    @keyframes float {

      0% {
        transform:
          translateY(0);
      }

      50% {
        transform:
          translateY(-8px);
      }

      100% {
        transform:
          translateY(0);
      }

    }


    /* Mobile */

    @media
    (max-width: 450px) {

      .landing-card {

        padding:
          55px
          23px
          45px;

      }


      h1 {

        font-size:
          37px;

      }

    }

  </style>

</head>


<body>


  <div
    class="blob-one">
  </div>


  <div
    class="blob-two">
  </div>


  <main
    class="landing-card">


    <div
      class="flower">

      🌷

    </div>


    <h1>

      Aya's Planner

    </h1>


    <p
      class="subtitle">

      A little space
      for my plans,

      <br>

      goals
      & gentle reminders ✨

    </p>


    <a
      href="planner.html"
      class="enter-button">

      Enter My Planner →

    </a>


    <p
      class="quote">

      ♡ plan softly,
      live beautifully ♡

    </p>


  </main>


</body>
</html>
